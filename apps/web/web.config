<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Serve static assets directly -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <rewrite>
      <rules>        
        <rule name="Static Next Assets" stopProcessing="true">
          <match url="^_next/static/(.*)$" />
          <action type="Rewrite" url=".next/static/{R:1}" />
        </rule>
        <rule name="Public Assets" stopProcessing="true">
          <match url="^(.*\.(png|jpg|jpeg|gif|svg|ico|webp|css|js|txt|woff2?|ttf))$" />
          <action type="None" />
        </rule>
        
        <rule name="Next Server" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Optional: Node process settings -->
    <iisnode loggingEnabled="true" nodeProcessCommandLine="node.exe" />
  </system.webServer>
</configuration>
