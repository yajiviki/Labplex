// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Lab {
  id        String   @id @default(cuid())
  labCode   String?  @unique // temporarily optional
  name      String
  address   String?
  phone     String? // temporarily optional
  email     String?  @unique
  isActive  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  appointments Appointment[]
  patients     Patient[]
}

model User {
  id    String  @id @default(cuid())
  labId String?
  lab   Lab?    @relation(fields: [labId], references: [id])

  employeeId String?   @unique
  userType   String? // 'PATIENT' | 'STAFF'
  name       String
  phone      String
  role       String // 'USER' | 'ADMIN' | 'SUPER_ADMIN'
  email      String?   @unique
  password   String
  isActive   Int       @default(1)
  dob        DateTime?
  address    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  passwordSetupTokens PasswordSetupToken[]
}

model PasswordSetupToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, token])
}

model Patient {
  id             String   @id @default(cuid())
  labId          String?
  lab            Lab?     @relation(fields: [labId], references: [id])
  patientId      String   @unique           // OP0001, OP0002...
  name           String
  tpaName        String?
  insuranceName  String?
  doctorName     String?
  address        String?
  phone          String
  isActive       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments   Appointment[] // if you relate appointments
}

// ----- Appointment -----
model Appointment {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  source            String
  visitType         String
  doctorName        String?
  insuranceVendorId String?
  notes             String?
  apptAt            DateTime
  status            String   @default("BOOKED")
  tatHours          Int?
  isActive          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
}

model Vendor {
  id            String   @id @default(cuid())
  vendorId      String   @unique      // TPA01, TPA02...
  tpaName       String
  insuranceName String?
  address       String?
  phone         String
  isActive      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
