generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bank {
  id          String       @id @default(cuid())
  bankId      String       @unique
  bankName    String
  accountName String
  accountNo   String       @unique
  ifsc        String
  address     String?
  isActive    Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bankVendor  BankVendor[]
}

model BankVendor {
  bankId   String
  vendorId String
  bank     Bank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([bankId, vendorId])
  @@index([vendorId])
}

model Lab {
  id           String        @id @default(cuid())
  labCode      String        @unique
  name         String
  address      String?
  phone        String?
  email        String?
  isActive     Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  nickName     String?
  appointments Appointment[]
  Billing      Billing[]
  labVendors   LabVendor[]
  Patient      Patient[]
  users        User[]
}

model User {
  id                   String               @id @default(cuid())
  labId                String
  userId               String               @unique
  name                 String
  phone                String
  role                 String
  password             String
  email                String?
  dob                  DateTime?
  address              String?
  isActive             Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  assignedAppointments Appointment[]        @relation("AppointmentAssignedTo")
  passwordSetupTokens  PasswordSetupToken[] @relation("PasswordSetupTokens")
  lab                  Lab                  @relation(fields: [labId], references: [id])

  @@index([labId])
  @@index([phone])
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation("PasswordSetupTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vendor {
  id           String        @id @default(cuid())
  vendorId     String        @unique
  tpaName      String
  address      String?
  phone        String?
  isActive     Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  email        String?
  nickName     String?
  appointments Appointment[]
  BankVendor   BankVendor[]
  Billing      Billing[]
  labVendors   LabVendor[]

  @@index([tpaName])
}

model LabVendor {
  labId    String
  vendorId String
  lab      Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([labId, vendorId])
  @@index([vendorId])
}

model InsuranceCompany {
  id           String        @id @default(cuid())
  code         String?       @unique
  name         String
  address      String?
  phone        String?
  isActive     Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  nickName     String?
  appointments Appointment[]

  @@index([name])
}

model Patient {
  id            String   @id @default(cuid())
  labId         String
  patientId     String
  name          String
  tpaName       String?
  insuranceName String?
  doctorName    String?
  address       String?
  phone         String
  isActive      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lab           Lab      @relation(fields: [labId], references: [id])

  @@unique([labId, patientId])
  @@index([labId])
  @@index([phone])
}

model Appointment {
  id                 String            @id @default(cuid())
  apptAt             DateTime
  vendorId           String?
  labId              String?
  insuranceCompanyId String?
  clientName         String
  clientRef          String?
  gender             String?
  age                Int?
  phone              String?
  visitType          String?
  location           String?
  status             String?
  extraChargeRs      Decimal?          @db.Decimal(12, 2)
  paymentStatus      String?
  isActive           Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  paymentDate        DateTime?
  serviceType        String?
  addressRemark      String?
  assignedAt         DateTime?
  assignedToId       String?
  testAmountRs       Float?            @default(0)
  assignedTo         User?             @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id])
  insuranceCompany   InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  lab                Lab?              @relation(fields: [labId], references: [id])
  vendor             Vendor?           @relation(fields: [vendorId], references: [id])
  tests              AppointmentTests?
  TravelExpense      TravelExpense[]

  @@unique([clientRef, apptAt])
  @@index([apptAt])
  @@index([vendorId])
  @@index([labId])
  @@index([insuranceCompanyId])
  @@index([assignedToId])
}

model AppointmentTests {
  appointmentId   String           @id
  urineTest       Boolean          @default(false)
  ecg             Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bloodTest       BloodTestType    @default(No)
  applicationForm ApplicationForm?
  tmt             Boolean          @default(false)
  appointment     Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Billing {
  id        String        @id @default(cuid())
  labId     String
  vendorId  String
  paidDate  DateTime
  amount    Decimal       @db.Decimal(12, 2)
  status    BillingStatus
  remarks   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lab       Lab           @relation(fields: [labId], references: [id])
  vendor    Vendor        @relation(fields: [vendorId], references: [id])

  @@index([labId, vendorId, paidDate])
}

model TravelExpense {
  id                  String      @id @default(cuid())
  appointmentId       String
  patientName         String
  travelDate          DateTime?
  travelFrom          String?
  travelTo            String?
  fuelAmount          Decimal     @default(0) @db.Decimal(12, 2)
  foodAmount          Decimal     @default(0) @db.Decimal(12, 2)
  accommodationAmount Decimal     @default(0) @db.Decimal(12, 2)
  otherAmount         Decimal     @default(0) @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  totalSpent          Decimal     @default(0) @db.Decimal(12, 2)
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([travelDate])
}

model PettyCashEntry {
  id          String   @id @default(uuid())
  entryDate   DateTime
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entryDate])
}

model TravelSettlement {
  id                String    @id @default(uuid())
  appointmentId     String    @unique
  staffId           String?
  patientName       String
  vendorId          String?
  labId             String?
  appointmentDate   DateTime?
  visitType         String?
  location          String?
  travelCost        Decimal   @default(0) @db.Decimal(12, 2)
  accommodationCost Decimal   @default(0) @db.Decimal(12, 2)
  totalSpent        Decimal   @default(0) @db.Decimal(12, 2)
  profitLossAmount  Decimal   @default(0) @db.Decimal(12, 2)
  profitLossStatus  String    @default("Break-even")
  remarks           String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tpaForecastAmount Decimal   @default(0) @db.Decimal(12, 2)

  @@index([staffId])
  @@index([vendorId])
  @@index([labId])
  @@index([appointmentDate])
  @@index([profitLossStatus])
}

model PettyCashAccount {
  id           String                 @id @default(cuid())
  name         String
  phone        String?
  notes        String?
  isActive     Int                    @default(1)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  accountType  PettyCashAccountType   @default(OTHER)
  transactions PettyCashTransaction[]

  @@index([name])
  @@index([accountType])
}

model PettyCashTransaction {
  id                 String           @id @default(cuid())
  pettyCashAccountId String
  txnDate            DateTime
  txnType            PettyCashTxnType
  amount             Decimal          @db.Decimal(12, 2)
  referenceNo        String?
  notes              String?
  isActive           Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  pettyCashAccount   PettyCashAccount @relation(fields: [pettyCashAccountId], references: [id], onDelete: Cascade)

  @@index([pettyCashAccountId])
  @@index([txnDate])
  @@index([txnType])
  @@index([isActive])
}

enum BillingStatus {
  Paid
  NotPaid
}

enum BloodTestType {
  No
  FB
  B
}

enum ApplicationForm {
  MER
  FMR
  ALL
}

enum PettyCashTxnType {
  RECEIVE
  REPAY
}

enum PettyCashAccountType {
  VENDOR
  PERSON
  STAFF
  OTHER
}
