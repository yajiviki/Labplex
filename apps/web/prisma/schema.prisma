// prisma/schema.prisma
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===========================================================
// Lab (tie-up labs)
// ===========================================================
model Lab {
  id        String   @id @default(cuid())
  labCode   String   @unique // e.g. LB01
  name      String
  nickName  String? 
  address   String?
  phone     String?
  email     String?
  isActive  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        User[]
  appointments Appointment[]
  labVendors   LabVendor[]
  Patient      Patient[]
}

// ===========================================================
// User (staff/admin + generic users)
// - userId is per-lab, composite unique with labId (U0001, U0002…)
// ===========================================================
model User {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  userId   String    @unique // <-- make globally unique now
  name     String
  phone    String
  role     String
  password String
  email    String?
  dob      DateTime?
  address  String?
  isActive Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordSetupTokens PasswordSetupToken[] @relation("PasswordSetupTokens")

  @@index([labId])
  @@index([phone])
}

// ===========================================================
// PasswordSetupToken (optional; used if you email setup links)
// ===========================================================
model PasswordSetupToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation("PasswordSetupTokens", fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===========================================================
// Vendor (TPA) and InsuranceCompany
// - vendorId = TPA01, TPA02… (human ID, unique)
// - Insurance companies belong to a TPA (via Vendor.id)
// ===========================================================
model Vendor {
  id        String   @id @default(cuid())
  vendorId  String
  tpaName   String
  nickName  String? 
  address   String?
  phone     String?
  email     String?
  isActive  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relations  
  appointments Appointment[] // appointments that reference this TPA
  labVendors   LabVendor[]

  @@unique([vendorId]) // strongly recommended so TPA01/TPA02 are unique
  @@index([tpaName])
}

model LabVendor {
  labId    String
  vendorId String

  lab    Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([labId, vendorId])
  @@index([vendorId])
}

model InsuranceCompany {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  nickName  String? 
  address   String? // ← make sure this exists
  phone     String?
  isActive  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([name])
}

// ===========================================================
// Patient (for Patient Management form)
// - patientId per-lab (OP0001…) composite unique with labId
// ===========================================================
model Patient {
  id String @id @default(cuid())

  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  patientId     String // e.g. OP0001 (per lab)
  name          String
  tpaName       String? // shown if Source is TPA
  insuranceName String?
  doctorName    String?
  address       String?
  phone         String
  isActive      Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //appointments Appointment[]

  @@unique([labId, patientId])
  @@index([labId])
  @@index([phone])
}

// ===========================================================
// Appointment
// - We store names for TPA/Insurance for your UI needs
// - Optional relation to Patient (when you map by patientId)
// ===========================================================

model Appointment {
  id String @id @default(cuid())

  // When
  apptAt DateTime

  // Patient (client) link — optional; make required if you always have a patient
  //patientId String?npx
  //patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // TPA (Vendor) link
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // Lab link
  labId String?
  lab   Lab?    @relation(fields: [labId], references: [id], onDelete: SetNull)

  // Insurance company link
  insuranceCompanyId String?
  insuranceCompany   InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id], onDelete: SetNull)

  // Client info (scalars)
  clientName String
  clientRef  String?
  gender     String?
  age        Int?
  //address    String?
  phone      String?

  // Visit / logistics
  visitType String?
  location  String?

  // Medical/report/payment
  status String?

  extraChargeRs Decimal? @db.Decimal(12, 2)
  paymentStatus String?

  // Bookkeeping
  isActive  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //Patient   Patient? @relation(fields: [patientId], references: [id])
  //patientId String?

  serviceType         String?   // e.g. 'Outer Area', 'Local', 'Walk-in'
  paymentDate         DateTime? // when payment was made (if any)

  @@unique([clientRef, apptAt])
  @@index([apptAt])
  //@@index([patientId])
  @@index([vendorId])
  @@index([labId])
  @@index([insuranceCompanyId])
}
